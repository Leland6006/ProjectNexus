# Local development only. Never use these credentials outside your workstation.
# Run `node scripts/dev-services.mjs setup` to generate strong local secrets.
NODE_ENV=development
HOST=127.0.0.1
PORT=4318

# App/API configuration. The issuer host must match the Keycloak host port mapping.
API_PUBLIC_URL=http://127.0.0.1:4318
NEXUS_API_URL=http://127.0.0.1:4318
OIDC_ISSUER=http://127.0.0.1:8080/realms/nexus-dev
OIDC_ACCOUNT_URL=http://127.0.0.1:8080/realms/nexus-dev/account
OIDC_CLIENT_ID=nexus-api
OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_LOCAL_SECRET
SESSION_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64

# Local-only database and Keycloak bootstrap credentials.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DATABASE_URL=postgresql://nexus:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@127.0.0.1:5432/nexus
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
